; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited via text for version control.

[application]

config/name="Till The End"
config/description="A roguelike 2.5D FPS survival game inspired by DOOM. Survive 12 waves of increasingly brutal hordes, level up, collect weapons, abilities, and traits, then face the final boss."
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.2", "Mobile")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/systems/game_manager.gd"
AudioManager="*res://scripts/systems/audio_manager.gd"
EventBus="*res://scripts/systems/event_bus.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/mode=0
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input]

move_forward={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":87,"physical_keycode":0,"key_label":0,"unicode":119,"location":0,"echo":false,"script":null)]
}
move_backward={
